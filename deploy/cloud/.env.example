# 多实例 + Redis 控制面部署的环境变量，复制为 .env 后填写
# cp .env.example .env

# 必填：访问令牌；多租户改用 SCRAPE_MCP_HTTP_TOKENS（单行 JSON）并保证两个实例一致
SCRAPE_MCP_HTTP_TOKEN=

# 对外端口（仅绑定 127.0.0.1）
SCRAPE_MCP_HTTP_PORT=8002

# HTTP 层每租户限流与日配额
SCRAPE_MCP_HTTP_QPS=5
SCRAPE_MCP_HTTP_DAILY_QUOTA=10000

# 上游清单（运维提供）。浏览器填 CDP 端点，代理条目可带 |region 标签
SCRAPE_MCP_CLOUD_BROWSER_UPSTREAMS=http://browser-pool-1:3000,http://browser-pool-2:3000
SCRAPE_MCP_CLOUD_PROXY_UPSTREAMS=socks5://proxy-us:1080|us,http://proxy-hk:8080|hk

# 租约有效期、单租户并发上限、每日租约配额（0 表示不限）
SCRAPE_MCP_CLOUD_LEASE_TTL=300
SCRAPE_MCP_CLOUD_MAX_LEASES_PER_TENANT=2
SCRAPE_MCP_CLOUD_DAILY_LEASES=0

# Redis 键前缀：多套环境共用一个 Redis 时务必区分
SCRAPE_MCP_REDIS_PREFIX=scrape_mcp

# 需要 L2 浏览器时设为 1（镜像显著变大）
INSTALL_BROWSER=0
