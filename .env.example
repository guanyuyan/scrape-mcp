# ================================================================
# scrape-mcp 配置模板
# 复制为 .env 后按需修改：cp .env.example .env  （.env 不入库）
# 所有键可省去前缀 SCRAPE_MCP_，也支持直接写全名（见 README）
# 优先级：实际进程环境变量 > 本 .env > 代码默认值
# ================================================================

# ---- L1 curl_cffi（默认打头阵的抓取层）----
# 浏览器指纹模板：chrome / safari 等
# SCRAPE_MCP_IMPERSONATE=chrome
# L1 请求超时（秒）
# SCRAPE_MCP_REQUEST_TIMEOUT=20
# 最大响应体（字节）
# SCRAPE_MCP_MAX_RESPONSE_BYTES=5242880
# 单次返回默认 token 预算上限
# SCRAPE_MCP_DEFAULT_MAX_TOKENS=4000
# max_tokens 可申请的上限
# SCRAPE_MCP_HARD_MAX_TOKENS=8000
# HTTP 代理，L1/L2 共用，如 http://127.0.0.1:7890
# SCRAPE_MCP_PROXY=
# 代理池（逗号/分号/空白分隔），按站点粘性轮询分配；非空时优先于上面的单代理
# SCRAPE_MCP_PROXY_POOL=http://127.0.0.1:7891,http://127.0.0.1:7892
# 同一出口连续失败多少次后进入冷却
# SCRAPE_MCP_PROXY_POOL_FAIL_THRESHOLD=2
# 出口冷却时长（秒）
# SCRAPE_MCP_PROXY_POOL_COOLDOWN=60
# 同一主机固定走同一出口的时长（秒）
# SCRAPE_MCP_PROXY_POOL_STICKY_TTL=300
# 请求 Accept-Language
# SCRAPE_MCP_ACCEPT_LANGUAGE=zh-CN,zh;q=0.9,en;q=0.8

# ---- M4 缓存与批量 ----
# 两层缓存（HTTP 响应 + 正文/抽取结果）TTL（秒）；0 全关
# SCRAPE_MCP_CACHE_TTL=300
# web_batch 单批并发上限
# SCRAPE_MCP_BATCH_MAX_CONCURRENCY=4
# web_batch 单批 URL 上限
# SCRAPE_MCP_BATCH_MAX_URLS=20
# 同一主机的并发上限（web_fetch / web_batch / web_crawl 共用）；跨主机仍可并行
# SCRAPE_MCP_HOST_MAX_CONCURRENCY=2
# web_crawl 单次最多抓取的页面数硬上限
# SCRAPE_MCP_CRAWL_MAX_PAGES=20

# ---- 传输层重试 ----
# 网络异常/5xx 的重试次数（429/403 属反爬信号，不做同层重试）
# SCRAPE_MCP_RETRY_TIMES=2
# 指数退避基数（秒）：第 n 次重试等待 retry_backoff * 2^(n-1)
# SCRAPE_MCP_RETRY_BACKOFF=0.5
# 429/503 带 Retry-After 时最多等待秒数；0=只在载荷里返回 retry_after_s，不自动等待
# SCRAPE_MCP_RETRY_AFTER_MAX_WAIT=0

# ---- 可观测 ----
# 日志级别（DEBUG/INFO/WARNING/ERROR）。日志为 JSON 行、只写 stderr
# SCRAPE_MCP_LOG_LEVEL=WARNING

# ---- 阶段 0 合规（责任边界）----
# 是否遵循目标站 robots.txt（默认 true；false 时会忽略抓取规则，仅建议自用合规场景关闭）
# SCRAPE_MCP_RESPECT_ROBOTS=true
# robots.txt 缓存 TTL（秒）
# SCRAPE_MCP_ROBOTS_CACHE_TTL=86400
# 主机白名单（逗号分隔，域名不含协议/端口）。非空时仅允许名单内主机
# SCRAPE_MCP_ALLOWED_HOSTS=
# 主机黑名单（逗号分隔）。denied 优先于 allowed
# SCRAPE_MCP_DENIED_HOSTS=
# 全网抓取限流（每秒请求数，web_fetch 与 web_batch 共用）；0 不限速
# SCRAPE_MCP_MAX_QPS=10

# ---- L2 浏览器渲染（Playwright，拦截才升级）----
# 是否启用升级链
# SCRAPE_MCP_L2_ENABLED=true
# 无头模式
# SCRAPE_MCP_L2_HEADLESS=true
# 浏览器渠道：留空=自带 Chromium；chrome / msedge=复用系统浏览器（免下载）
# SCRAPE_MCP_L2_CHANNEL=chrome
# 导航超时（秒）
# SCRAPE_MCP_L2_NAVIGATE_TIMEOUT=30
# 挑战页观察窗口（秒）
# SCRAPE_MCP_L2_SETTLE_TIMEOUT=8
# 页面语言
# SCRAPE_MCP_L2_LOCALE=zh-CN
# 隐身加固时区
# SCRAPE_MCP_L2_TIMEZONE=Asia/Shanghai
# L2 滚动步数（用于触发无限滚动/懒加载）
# SCRAPE_MCP_L2_SCROLL_STEPS=5
# 每步滚动间隔（毫秒）
# SCRAPE_MCP_L2_SCROLL_DELAY_MS=400
# 同时打开的页面上限：超出时排队
# SCRAPE_MCP_L2_MAX_PAGES=3
# 常驻 context 上限（按 host + session 复用，超出按最久未用淘汰）
# SCRAPE_MCP_L2_MAX_CONTEXTS=8
# 浏览器空闲回收阈值（秒）；0=常驻到进程退出
# SCRAPE_MCP_L2_IDLE_TIMEOUT=120

# ---- M3 登录态持久化 ----
# 登录态（cookie/localStorage）与缓存落盘目录（不提交到仓库）
# SCRAPE_MCP_DATA_DIR=~/.scrape_mcp
# 站点 recipe 目录；留空用 <DATA_DIR>/recipes
# SCRAPE_MCP_RECIPES_DIR=
# PDF 单次最多解析的页数（需安装 mcp-scrape[pdf]）
# SCRAPE_MCP_PDF_MAX_PAGES=200
# login 工具手动登录等待上限（秒）
# SCRAPE_MCP_LOGIN_TIMEOUT=180

# ---- 数据集导出 ----
# 非空时把每次成功抓取追加到该 JSONL（一行一条），供后续训练/检索使用；留空不导出
# SCRAPE_MCP_DATASET=~/datasets/scrapes.jsonl

# ---- 传输模式 ----
# stdio（默认） / streamable-http（Postman/curl 直连）
# SCRAPE_MCP_TRANSPORT=stdio
# streamable-http 时监听 host/port
# SCRAPE_MCP_HTTP_HOST=127.0.0.1
# SCRAPE_MCP_HTTP_PORT=8000
# streamable-http 纯 JSON 响应（0=事件流）
# SCRAPE_MCP_HTTP_JSON=1
# streamable-http 免握手（0=有状态）
# SCRAPE_MCP_HTTP_STATELESS=1
# HTTP 访问令牌：设置后除 /healthz 外所有请求需带 Authorization: Bearer <token>；
# 绑定非回环地址（如 0.0.0.0）时必须设置，否则拒绝启动
# 下面三项（单令牌 / 多令牌 JSON / 多令牌文件）互斥，只保留一处
# SCRAPE_MCP_HTTP_TOKEN=
# 多令牌（多租户）：每项独立配额，qps / daily_quota 省略时继承下面的全局值，写 0 表示该租户不限
# SCRAPE_MCP_HTTP_TOKENS=[{"name":"team-a","token":"<随机串>","qps":2,"daily_quota":2000},{"name":"ci","token":"<随机串>"}]
# 多令牌配置文件（同格式 JSON），适合把令牌放卷上保管
# SCRAPE_MCP_HTTP_TOKENS_FILE=/data/tokens.json
# 每秒请求上限（令牌桶，允许同量突发）；超出返回 429 + Retry-After；0 不限
# 多令牌时作为省略 qps 的租户默认值
# SCRAPE_MCP_HTTP_QPS=5
# 每日请求配额（UTC 自然日，跨日清零）；超出返回 429；0 不限
# 多令牌时作为省略 daily_quota 的租户默认值
# SCRAPE_MCP_HTTP_DAILY_QUOTA=10000