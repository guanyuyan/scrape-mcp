# ================================================================
# scrape-mcp 配置模板
# 复制为 .env 后按需修改：cp .env.example .env  （.env 不入库）
# 所有键可省去前缀 SCRAPE_MCP_，也支持直接写全名（见 README）
# 优先级：实际进程环境变量 > 本 .env > 代码默认值
# ================================================================

# ---- L1 curl_cffi（默认打头阵的抓取层）----
# 浏览器指纹模板：chrome / safari 等
# SCRAPE_MCP_IMPERSONATE=chrome
# L1 请求超时（秒）
# SCRAPE_MCP_REQUEST_TIMEOUT=20
# 最大响应体（字节）
# SCRAPE_MCP_MAX_RESPONSE_BYTES=5242880
# 单次返回默认 token 预算上限
# SCRAPE_MCP_DEFAULT_MAX_TOKENS=4000
# max_tokens 可申请的上限
# SCRAPE_MCP_HARD_MAX_TOKENS=8000
# HTTP 代理，L1/L2 共用，如 http://127.0.0.1:7890
# SCRAPE_MCP_PROXY=
# 请求 Accept-Language
# SCRAPE_MCP_ACCEPT_LANGUAGE=zh-CN,zh;q=0.9,en;q=0.8

# ---- M4 缓存与批量 ----
# L1 明文响应磁盘缓存 TTL（秒）；0 关闭
# SCRAPE_MCP_CACHE_TTL=300
# web_batch 单批并发上限
# SCRAPE_MCP_BATCH_MAX_CONCURRENCY=4
# web_batch 单批 URL 上限
# SCRAPE_MCP_BATCH_MAX_URLS=20

# ---- 阶段 0 合规（责任边界）----
# 是否遵循目标站 robots.txt（默认 true；false 时会忽略抓取规则，仅建议自用合规场景关闭）
# SCRAPE_MCP_RESPECT_ROBOTS=true
# robots.txt 缓存 TTL（秒）
# SCRAPE_MCP_ROBOTS_CACHE_TTL=86400
# 主机白名单（逗号分隔，域名不含协议/端口）。非空时仅允许名单内主机
# SCRAPE_MCP_ALLOWED_HOSTS=
# 主机黑名单（逗号分隔）。denied 优先于 allowed
# SCRAPE_MCP_DENIED_HOSTS=
# 全网抓取限流（每秒请求数，web_fetch 与 web_batch 共用）；0 不限速
# SCRAPE_MCP_MAX_QPS=10

# ---- L2 浏览器渲染（Playwright，拦截才升级）----
# 是否启用升级链
# SCRAPE_MCP_L2_ENABLED=true
# 无头模式
# SCRAPE_MCP_L2_HEADLESS=true
# 浏览器渠道：留空=自带 Chromium；chrome / msedge=复用系统浏览器（免下载）
# SCRAPE_MCP_L2_CHANNEL=chrome
# 导航超时（秒）
# SCRAPE_MCP_L2_NAVIGATE_TIMEOUT=30
# 挑战页观察窗口（秒）
# SCRAPE_MCP_L2_SETTLE_TIMEOUT=8
# 页面语言
# SCRAPE_MCP_L2_LOCALE=zh-CN
# 隐身加固时区
# SCRAPE_MCP_L2_TIMEZONE=Asia/Shanghai

# ---- M3 登录态持久化 ----
# 登录态（cookie/localStorage）与缓存落盘目录（不提交到仓库）
# SCRAPE_MCP_DATA_DIR=~/.scrape_mcp
# login 工具手动登录等待上限（秒）
# SCRAPE_MCP_LOGIN_TIMEOUT=180

# ---- 传输模式 ----
# stdio（默认） / streamable-http（Postman/curl 直连）
# SCRAPE_MCP_TRANSPORT=stdio
# streamable-http 时监听 host/port
# SCRAPE_MCP_HTTP_HOST=127.0.0.1
# SCRAPE_MCP_HTTP_PORT=8000
# streamable-http 纯 JSON 响应（0=事件流）
# SCRAPE_MCP_HTTP_JSON=1
# streamable-http 免握手（0=有状态）
# SCRAPE_MCP_HTTP_STATELESS=1